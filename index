<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alya ❤️ Zaahid</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family: "Segoe UI", sans-serif;
    height:100vh;
    overflow:hidden;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#ff9a9e,#fad0c4);
}

.container{
    text-align:center;
    z-index:10;
}

h1{
    font-size:3rem;
    color:white;
    text-shadow:2px 2px 10px rgba(0,0,0,0.2);
    margin-bottom:30px;
}

p{
    color:white;
    font-size:1.2rem;
    margin-bottom:30px;
}

button{
    padding:15px 35px;
    font-size:22px;
    border:none;
    border-radius:50px;
    cursor:pointer;
    transition:0.3s;
}

#yes{
    background:#4CAF50;
    color:white;
}

#yes:hover{
    transform:scale(1.1);
}

#no{
    background:#ff4d4d;
    color:white;
    position:absolute;
}

.heart{
    position:absolute;
    color:white;
    animation:float 8s linear infinite;
    opacity:0.7;
}

@keyframes float{
    from{
        transform:translateY(100vh);
    }
    to{
        transform:translateY(-100px);
    }
}

.success{
    color:white;
    text-align:center;
}

.success h1{
    font-size:4rem;
}

.success p{
    font-size:1.5rem;
}
</style>
